+    /// sml2-android: turns hat and left-stick axes into F25-F32 presses, in
+    /// the order hat up/down/left/right, then stick up/down/left/right.
+    fn handle_gamepad_axes<F>(
+        &mut self,
+        motion_event: &android_activity::input::MotionEvent<'_>,
+        callback: &mut F,
+    ) where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        const DEAD_ZONE: f32 = 0.5;
+        const KEYS: [KeyCode; 8] = [
+            KeyCode::F25,
+            KeyCode::F26,
+            KeyCode::F27,
+            KeyCode::F28,
+            KeyCode::F29,
+            KeyCode::F30,
+            KeyCode::F31,
+            KeyCode::F32,
+        ];
+        if motion_event.pointer_count() == 0 {
+            return;
+        }
+        let pointer = motion_event.pointer_at_index(0);
+        let (hat_x, hat_y) = (pointer.axis_value(Axis::HatX), pointer.axis_value(Axis::HatY));
+        let (stick_x, stick_y) = (pointer.axis_value(Axis::X), pointer.axis_value(Axis::Y));
+        let held = [
+            hat_y < -DEAD_ZONE,
+            hat_y > DEAD_ZONE,
+            hat_x < -DEAD_ZONE,
+            hat_x > DEAD_ZONE,
+            stick_y < -DEAD_ZONE,
+            stick_y > DEAD_ZONE,
+            stick_x < -DEAD_ZONE,
+            stick_x > DEAD_ZONE,
+        ];
+        for (index, (&now, key)) in held.iter().zip(KEYS).enumerate() {
+            if self.gamepad_directions[index] == now {
+                continue;
+            }
+            self.gamepad_directions[index] = now;
+            let event = event::Event::WindowEvent {
+                window_id: window::WindowId(WindowId),
+                event: event::WindowEvent::KeyboardInput {
+                    device_id: event::DeviceId(DeviceId(motion_event.device_id())),
+                    event: event::KeyEvent {
+                        state: if now {
+                            event::ElementState::Pressed
+                        } else {
+                            event::ElementState::Released
+                        },
+                        physical_key: PhysicalKey::Code(key),
+                        logical_key: Key::Unidentified(NativeKey::Unidentified),
+                        location: KeyLocation::Standard,
+                        repeat: false,
+                        text: None,
+                        platform_specific: KeyEventExtra {},
+                    },
+                    is_synthetic: false,
+                },
+            };
+            callback(event, self.window_target());
+        }
+    }
+
     pub fn run<F>(mut self, event_handler: F) -> Result<(), EventLoopError>
     where
         F: FnMut(event::Event<T>, &event_loop::ActiveEventLoop),
